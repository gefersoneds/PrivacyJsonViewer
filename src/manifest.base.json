{
  "manifest_version": 3,
  "name": "JSON Path Viewer",
  "version": "3.0.0",
  "description": "Exibe JSON de forma legivel com busca por caminho (path) em qualquer profundidade.",
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["viewer.css"],
      "run_at": "document_end"
    }
  ]
}
